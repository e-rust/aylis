  if Nome = 'btnDividir' then
    Result := btnDividir;
  if Nome = 'btn7' then
    Result := btn7;
  if Nome = 'btn8' then
    Result := btn8;
  if Nome = 'btn9' then
    Result := btn9;
  if Nome = 'btnMultiplicar' then
    Result := btnMultiplicar;
  if Nome = 'btn4' then
    Result := btn4;
  if Nome = 'btn5' then
    Result := btn5;
  if Nome = 'btn6' then
    Result := btn6;
  if Nome = 'btnSubtrair' then
    Result := btnSubtrair;
  if Nome = 'btn1' then
    Result := btn1;
  if Nome = 'btn2' then
    Result := btn2;
  if Nome = 'btn3' then
    Result := btn3;
  if Nome = 'btnSomar' then
    Result := btnSomar;
  if Nome = 'btnSinal' then
    Result := btnSinal;
  if Nome = 'btn0' then
    Result := btn0;
  if Nome = 'btnVirgula' then
    Result := btnVirgula;
  if Nome = 'btnIgual' then
    Result := btnIgual;
end;

function TFrmCalculadoraBase.SenderAsButton(Sender: TAylisComponent): TButton;
begin
  Result := nil;
  if Sender <> nil then
    Result := FindButton(Sender.Name);
end;

function TFrmCalculadoraBase.SenderAsButton(Event: TJSONObject): TButton;
begin
  Result := FindButton(TJSONObject(Event.Find('sender')).Get('name', ''));
end;

