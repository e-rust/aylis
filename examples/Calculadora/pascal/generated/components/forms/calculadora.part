function TFrmCalculadoraBase.FindButton(const Nome: string): TButton;
begin
  Result := nil;
  if Nome = 'btnLimparHistorico' then
    Result := btnLimparHistorico;
  if Nome = 'btnHistorico' then
    Result := btnHistorico;
  if Nome = 'btnMC' then
    Result := btnMC;
  if Nome = 'btnMR' then
    Result := btnMR;
  if Nome = 'btnMMais' then
    Result := btnMMais;
