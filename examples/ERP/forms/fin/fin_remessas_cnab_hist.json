{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "frmFinRemessasCnabHist",
    "caption": "Remessas CNAB — itens de todos (Financeiro)",
    "on_show": "form_show",
    "width": 1100,
    "height": 700,
    "padding": 8,
    "children": [
      {
        "class": "ClientDataSet",
        "name": "cdsItens",
        "key_fields": "id",
        "children": [
          {
            "class": "Field",
            "name": "cdsItensId",
            "field_name": "id",
            "type": "auto_inc",
            "display_label": "Id",
            "display_width": 50,
            "read_only": true
          },
          {
            "class": "Field",
            "name": "cdsItensMestreId",
            "field_name": "mestre_id",
            "type": "integer",
            "display_label": "Documento",
            "display_width": 80,
            "visible": false
          },
          {
            "class": "Field",
            "name": "cdsItensItem",
            "field_name": "item",
            "size": 80,
            "display_label": "Item",
            "display_width": 240
          },
          {
            "class": "Field",
            "name": "cdsItensQuantidade",
            "field_name": "quantidade",
            "type": "integer",
            "display_label": "Qtd.",
            "display_width": 60
          },
          {
            "class": "Field",
            "name": "cdsItensValorUnitario",
            "field_name": "valor_unitario",
            "type": "currency",
            "display_label": "Valor unitário",
            "display_width": 110,
            "display_format": "#,##0.00"
          },
          {
            "class": "Field",
            "name": "cdsItensValorTotal",
            "field_name": "valor_total",
            "type": "currency",
            "display_label": "Total",
            "display_width": 110,
            "display_format": "#,##0.00"
          }
        ]
      },
      {
        "class": "DataSource",
        "name": "dsItens",
        "data_set": "cdsItens"
      },
      {
        "class": "Panel",
        "name": "pnlBarra",
        "height": 44,
        "align": "top",
        "padding": 6,
        "children": [
          {
            "class": "Edit",
            "name": "edtBusca",
            "placeholder": "Buscar…",
            "on_change": "edt_busca_change",
            "width": 260,
            "align": "right"
          }
        ]
      },
      {
        "class": "Label",
        "name": "lblStatus",
        "height": 24,
        "align": "bottom",
        "margins": [4, 4, 4, 0]
      },
      {
        "class": "DataGrid",
        "name": "grdItens",
        "data_source": "dsItens",
        "read_only": true,
        "filter_row": true,
        "align": "client"
      }
    ]
  }
}
