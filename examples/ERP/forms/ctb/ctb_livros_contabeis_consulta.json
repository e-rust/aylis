{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "frmCtbLivrosContabeisConsulta",
    "caption": "Livros contábeis — consulta (Contábil)",
    "on_show": "form_show",
    "width": 1100,
    "height": 700,
    "padding": 8,
    "children": [
      {
        "class": "ClientDataSet",
        "name": "cdsMestre",
        "key_fields": "id",
        "index_field_names": "nome",
        "children": [
          {
            "class": "Field",
            "name": "cdsMestreId",
            "field_name": "id",
            "type": "auto_inc",
            "display_label": "Id",
            "display_width": 50,
            "read_only": true
          },
          {
            "class": "Field",
            "name": "cdsMestreCodigo",
            "field_name": "codigo",
            "size": 10,
            "display_label": "Código",
            "display_width": 80
          },
          {
            "class": "Field",
            "name": "cdsMestreNome",
            "field_name": "nome",
            "size": 80,
            "display_label": "Nome",
            "display_width": 220,
            "required": true
          },
          {
            "class": "Field",
            "name": "cdsMestreAtivo",
            "field_name": "ativo",
            "type": "boolean",
            "display_label": "Ativo",
            "display_width": 50
          },
          {
            "class": "Field",
            "name": "cdsMestreCriadoEm",
            "field_name": "criado_em",
            "type": "date",
            "display_label": "Cadastrado em",
            "display_width": 100
          },
          {
            "class": "Field",
            "name": "cdsMestreObservacao",
            "field_name": "observacao",
            "size": 200,
            "display_label": "Observação",
            "display_width": 220
          }
        ]
      },
      {
        "class": "DataSource",
        "name": "dsMestre",
        "data_set": "cdsMestre"
      },
      {
        "class": "ClientDataSet",
        "name": "cdsItens",
        "key_fields": "id",
        "master_source": "dsMestre",
        "master_fields": "mestre_id=id",
        "children": [
          {
            "class": "Field",
            "name": "cdsItensId",
            "field_name": "id",
            "type": "auto_inc",
            "display_label": "Id",
            "display_width": 50,
            "read_only": true
          },
          {
            "class": "Field",
            "name": "cdsItensMestreId",
            "field_name": "mestre_id",
            "type": "integer",
            "display_label": "Cadastro",
            "display_width": 70,
            "visible": false
          },
          {
            "class": "Field",
            "name": "cdsItensData",
            "field_name": "data",
            "type": "date",
            "display_label": "Data",
            "display_width": 100
          },
          {
            "class": "Field",
            "name": "cdsItensDescricao",
            "field_name": "descricao",
            "size": 120,
            "display_label": "Ocorrência",
            "display_width": 260
          },
          {
            "class": "Field",
            "name": "cdsItensResponsavel",
            "field_name": "responsavel",
            "size": 60,
            "display_label": "Responsável",
            "display_width": 140
          }
        ]
      },
      {
        "class": "DataSource",
        "name": "dsItens",
        "data_set": "cdsItens"
      },
      {
        "class": "Panel",
        "name": "pnlBarra",
        "height": 44,
        "align": "top",
        "padding": 6,
        "children": [
          {
            "class": "Edit",
            "name": "edtBusca",
            "placeholder": "Buscar livros contábeis…",
            "on_change": "edt_busca_change",
            "width": 260,
            "align": "right"
          }
        ]
      },
      {
        "class": "Label",
        "name": "lblStatus",
        "height": 24,
        "align": "bottom",
        "margins": [4, 4, 4, 0]
      },
      {
        "class": "GroupBox",
        "name": "gbMestre",
        "caption": "Livros contábeis",
        "height": 320,
        "align": "top",
        "padding": [8, 24, 8, 8],
        "children": [
          {
            "class": "DataGrid",
            "name": "grdMestre",
            "data_source": "dsMestre",
            "read_only": true,
            "filter_row": true,
            "align": "client"
          }
        ]
      },
      {
        "class": "Splitter",
        "name": "splConsulta",
        "align": "top"
      },
      {
        "class": "GroupBox",
        "name": "gbItens",
        "caption": "Histórico",
        "align": "client",
        "padding": [8, 24, 8, 8],
        "children": [
          {
            "class": "DataGrid",
            "name": "grdItens",
            "data_source": "dsItens",
            "read_only": true,
            "filter_row": true,
            "align": "client"
          }
        ]
      }
    ]
  }
}
