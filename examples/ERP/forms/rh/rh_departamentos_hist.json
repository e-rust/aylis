{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "frmRhDepartamentosHist",
    "caption": "Departamentos — histórico de todos (RH)",
    "on_show": "form_show",
    "width": 1100,
    "height": 700,
    "padding": 8,
    "children": [
      {
        "class": "ClientDataSet",
        "name": "cdsItens",
        "key_fields": "id",
        "children": [
          {
            "class": "Field",
            "name": "cdsItensId",
            "field_name": "id",
            "type": "auto_inc",
            "display_label": "Id",
            "display_width": 50,
            "read_only": true
          },
          {
            "class": "Field",
            "name": "cdsItensMestreId",
            "field_name": "mestre_id",
            "type": "integer",
            "display_label": "Cadastro",
            "display_width": 70,
            "visible": false
          },
          {
            "class": "Field",
            "name": "cdsItensData",
            "field_name": "data",
            "type": "date",
            "display_label": "Data",
            "display_width": 100
          },
          {
            "class": "Field",
            "name": "cdsItensDescricao",
            "field_name": "descricao",
            "size": 120,
            "display_label": "Ocorrência",
            "display_width": 260
          },
          {
            "class": "Field",
            "name": "cdsItensResponsavel",
            "field_name": "responsavel",
            "size": 60,
            "display_label": "Responsável",
            "display_width": 140
          }
        ]
      },
      {
        "class": "DataSource",
        "name": "dsItens",
        "data_set": "cdsItens"
      },
      {
        "class": "Panel",
        "name": "pnlBarra",
        "height": 44,
        "align": "top",
        "padding": 6,
        "children": [
          {
            "class": "Edit",
            "name": "edtBusca",
            "placeholder": "Buscar…",
            "on_change": "edt_busca_change",
            "width": 260,
            "align": "right"
          }
        ]
      },
      {
        "class": "Label",
        "name": "lblStatus",
        "height": 24,
        "align": "bottom",
        "margins": [4, 4, 4, 0]
      },
      {
        "class": "DataGrid",
        "name": "grdItens",
        "data_source": "dsItens",
        "read_only": true,
        "filter_row": true,
        "align": "client"
      }
    ]
  }
}
