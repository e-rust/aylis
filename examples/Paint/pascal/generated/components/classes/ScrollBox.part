function TScrollBox.GetOverscroll: TOverscroll;
begin
  Result := OverscrollOf(GetProp('overscroll'));
end;

procedure TScrollBox.SetOverscroll(Value: TOverscroll);
begin
  SetProp('overscroll', TJSONString.Create(OverscrollNames[Value]));
end;

