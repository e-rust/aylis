/** A janela de frmPaint cujo evento está rodando (a primeira, fora dos handlers). */
export let frmPaint: FrmPaintComponents;
registerFormClass("frmPaint", FrmPaintComponents, (form) => {
    frmPaint = form as FrmPaintComponents;
});
