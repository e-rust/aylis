  btnAdicionar := TButton(Resolve(List, 'btnAdicionar', 'Button', TButton));
  btnLimparFila := TButton(Resolve(List, 'btnLimparFila', 'Button', TButton));
  lvFila := TListView(Resolve(List, 'lvFila', 'ListView', TListView));
