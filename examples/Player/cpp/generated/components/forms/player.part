
// O form frmPlayer e os componentes dele (resolvidos ao abrir; cada janela tem a sua instância).
struct FrmPlayerComponents : Form {
    MainMenu mnuPrincipal;
    MenuItem mnuArquivo;
    MenuItem mnuAbrir;
    MenuItem mnuLimparFila;
    MenuItem mnuSep1;
    MenuItem mnuSair;
    MenuItem mnuReproduzir;
