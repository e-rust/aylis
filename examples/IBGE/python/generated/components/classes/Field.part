

class Field(AylisComponent):
    """Um Field de um form."""

    @property
    def field_name(self):
        return self._get("field_name")

    @field_name.setter
    def field_name(self, value):
        self._set("field_name", value)

    @property
    def type(self):
        return self._get("type")

    @type.setter
    def type(self, value):
        self._set("type", value)

    @property
    def size(self):
        return self._get("size")

    @size.setter
    def size(self, value):
        self._set("size", value)

    @property
    def scale(self):
        return self._get("scale")

    @scale.setter
    def scale(self, value):
        self._set("scale", value)

    @property
    def rounding(self):
        return self._get("rounding")

    @rounding.setter
    def rounding(self, value):
        self._set("rounding", value)

    @property
