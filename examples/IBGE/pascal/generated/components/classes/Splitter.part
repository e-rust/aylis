function TSplitter.GetMinSize: Double;
begin
  Result := GetProp('min_size').AsFloat;
end;

procedure TSplitter.SetMinSize(Value: Double);
begin
  SetProp('min_size', TJSONFloatNumber.Create(Value));
end;

