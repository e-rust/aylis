
// Um DataGrid de um form.
struct DataGrid : aylis::Component {
    DataGrid() = default;
    explicit DataGrid(const aylis::Component& c) : aylis::Component(c) {}
    std::string data_source() const { return get_prop_("data_source").str(); }
