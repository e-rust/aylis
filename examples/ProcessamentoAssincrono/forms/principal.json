{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "frmPrincipal",
    "caption": "Fechamento do mês",
    "width": 440,
    "height": 200,
    "padding": 16,
    "children": [
      {
        "class": "Label",
        "name": "lblTitulo",
        "text": "Processa as notas do mês numa thread própria, com o andamento num form modal.",
        "wrap": true,
        "height": 40,
        "align": "top"
      },
      {
        "class": "Button",
        "name": "btnFecharMes",
        "text": "Fechar o mês",
        "height": 38,
        "align": "top",
        "margins": [0, 8, 0, 0],
        "on_click": "fechar_mes_click"
      },
      {
        "class": "Label",
        "name": "lblStatus",
        "text": "Pronto",
        "height": 32,
        "align": "top",
        "margins": [0, 12, 0, 0]
      }
    ]
  }
}
